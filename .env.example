# Copy to .env (root, used by docker compose). Never commit .env.
COMPOSE_PROJECT_NAME=jarvis

# --- Database / cache ---
DB_DATABASE=jarvis
DB_USERNAME=jarvis
DB_PASSWORD=change-me-local-only
REDIS_PASSWORD=change-me-local-only

# --- Application DB roles (created by 'make db-provision') ---
DB_OWNER_PASSWORD=change-me-local-only
DB_APP_PASSWORD=change-me-local-only
DB_ADMIN_PASSWORD=change-me-local-only

# --- Laravel (apps/web) ---
APP_ENV=local
APP_KEY=
APP_URL=http://localhost:8080
BRAND_NAME="JARVIS ONE"

# --- Laravel <-> AI engine shared secrets (>= 32 chars each, different from each other) ---
# Generate: openssl rand -hex 32
AI_ENGINE_URL=http://ai-engine:8000
AI_ENGINE_HMAC_SECRET=
AI_ENGINE_JWT_SECRET=
# Provider credential vault (AES-256-GCM). Generate: php -r "echo 'base64:'.base64_encode(random_bytes(32)),PHP_EOL;"
# Do NOT reuse APP_KEY. Keep a copy offline: losing it makes every stored provider key unreadable.
# Outreach: "Connect Gmail / Outlook" (leave empty to hide; see ENVIRONMENT_SETUP.md)
OUTREACH_GOOGLE_CLIENT_ID=
OUTREACH_GOOGLE_CLIENT_SECRET=
OUTREACH_MS_CLIENT_ID=
OUTREACH_MS_CLIENT_SECRET=
OUTREACH_MS_TENANT=common
AI_VAULT_CURRENT=1
AI_VAULT_KEY_1=
