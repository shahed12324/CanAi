# JARVIS ONE - nginx site (generated by install-vps.sh; placeholders: @SERVER_NAME@ @ROOT@ @PHP_SOCK@)
server {
    listen 80;
    listen [::]:80;
    server_name @SERVER_NAME@;
    root @ROOT@;
    index index.php;
    charset utf-8;
    client_max_body_size 2m;            # chat attachments are capped at 200 KB each by the app

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Streaming chat answers (Server-Sent Events): no buffering anywhere, long timeout.
    location ~ "^/app/chat/(send|[0-9a-z]{26}/regenerate)$" {
        fastcgi_pass unix:@PHP_SOCK@;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_buffering off;
        gzip off;
        fastcgi_read_timeout 300s;
        fastcgi_send_timeout 300s;
    }

    location ~ \.php$ {
        fastcgi_pass unix:@PHP_SOCK@;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_read_timeout 60s;
    }

    location ~ /\.(?!well-known) { deny all; }
    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }
}
