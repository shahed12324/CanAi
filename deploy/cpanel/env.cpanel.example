APP_NAME="JARVIS ONE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database lives on your VPS (see deploy/enable-remote.sh output). TLS is mandatory.
DB_CONNECTION=pgsql
DB_HOST=vps.your-domain.example
DB_PORT=5432
DB_DATABASE=jarvis
DB_SSLMODE=require
DB_USERNAME=jarvis_app
DB_PASSWORD=
DB_ADMIN_USERNAME=jarvis_admin_login
DB_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# AI engine on the VPS (HTTPS, reached through /engine/). Copy the SAME secrets as the VPS .env.
AI_ENGINE_URL=https://vps.your-domain.example/engine
AI_ENGINE_HMAC_SECRET=
AI_ENGINE_JWT_SECRET=
AI_VAULT_CURRENT=1
AI_VAULT_KEY_1=

# Mail: create a mailbox in cPanel and use its SMTP details.
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@your-domain.example
MAIL_FROM_NAME="JARVIS ONE"

CREDITS_SIGNUP_GRANT=100
