{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAN AI Agent",
  "version": "1.0.0",
  "identifier": "app.jarvisone.agent",
  "build": { "frontendDist": "./ui" },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "label": "main", "title": "CAN AI — Agent", "width": 1100, "height": 760, "minWidth": 320, "minHeight": 520, "visible": true }
    ],
    "security": { "csp": "default-src 'self'; style-src 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "Utility"
  }
}
